{
  "manifest_version": 3,
  "name": "macOS Computer Use — Browser Accelerator",
  "version": "0.1.0",
  "description": "Fast, zero-focus-stealing DOM/tab bridge for macOS Computer Use over Chrome Native Messaging.",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "macOS Computer Use Bridge",
    "default_popup": "popup.html"
  }
}
