{
  "name": "macos-computer-use-mcp",
  "version": "3.0.1",
  "type": "module",
  "description": "Native macOS Computer Use MCP server with a live agent cursor, Apple Vision OCR, fail-closed targeting, and Accessibility actions.",
  "main": "server.mjs",
  "bin": {
    "macos-computer-use-mcp": "server.mjs",
    "macos-computer-use": "server.mjs"
  },
  "files": [
    "server.mjs",
    "dist",
    "native",
    "native_helper",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:swift && npm run build:ts",
    "build:swift": "swiftc -O native/*.swift native/*/*.swift -o native_helper",
    "build:ts": "tsc",
    "build:release": "./scripts/build-universal.sh && npm run build:ts",
    "test": "npm run build:ts && node --test test/*.test.mjs",
    "test:background": "npm run build:ts && node test/background-smoke.mjs",
    "test:live": "npm run build:ts && node test/live-smoke.mjs",
    "prepack": "npm run build:release",
    "prepublishOnly": "npm test",
    "start": "node server.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "macos",
    "computer-use",
    "automation",
    "vision",
    "ocr",
    "antigravity",
    "claude",
    "openclaw"
  ],
  "author": "John Oba <obajohn75@gmail.com>",
  "license": "MIT",
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnexzy/macos-computer-use.git"
  },
  "bugs": {
    "url": "https://github.com/johnexzy/macos-computer-use/issues"
  },
  "homepage": "https://github.com/johnexzy/macos-computer-use#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
